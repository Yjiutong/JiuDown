# ---- 编辑器 / 本地环境 ----
# 虚拟环境不入库：自行 `python -m venv .venv`，或双击「首次安装.bat」拉取 runtime
/.vscode
/.venv
# ---- 发布产物与第三方构建工具（均由 tools/build_release.py 生成/下载） ----
/build
/dist
/tools/_vendor/

# ---- AI 工作记忆（本地私有，不入库） ----
/.workbuddy/

# ---- 运行时数据与产物 ----
/config
/Download
/downloads
/logs
/TEMP
__pycache__/
*.py[cod]
*.zip
*.bak
*.part
# 例外：组件包随仓库分发（离线即可完成首次安装），单包最大约 32MB，均 < 100MB
!/build_components/*.zip
!/build_components/manifest.json

# ---- 二进制依赖（体积大不入库，首次运行自动下载） ----
# app.ico 例外：打包所需的图标必须入库
/runtime
/resources/*
!/resources/app.ico
